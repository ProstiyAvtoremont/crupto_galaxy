---
const { color = '#4fe3ff', tilt = -25, size = 56 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 48 48" aria-hidden="true">
  <ellipse cx="24" cy="24" rx="21" ry="8" fill="none" stroke={color} stroke-opacity="0.6" stroke-width="1.5" transform={`rotate(${tilt} 24 24)`} />
  <circle cx="24" cy="24" r="8" fill={color} />
  <circle cx="24" cy="24" r="8" fill="url(#g)" opacity="0.35" />
  <defs><radialGradient id="g" cx="30%" cy="30%"><stop offset="0" stop-color="#fff" /><stop offset="1" stop-color="#000" stop-opacity="0.6" /></radialGradient></defs>
</svg>

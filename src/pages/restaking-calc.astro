---
import Base from '../layouts/Base.astro';
import { AFFILIATES } from '../config';
---
<Base title="Restaking Points & Yield Calculator: EigenLayer, Symbiotic, Karak" description="Estimate restaking points, your share of the pool and expected net profit for EigenLayer, Symbiotic and Karak over 30, 60 or 90 days.">
  <div class="wrap pt-12">
    <h1 class="font-display text-3xl sm:text-4xl font-extrabold">What could your restaked ETH earn?</h1>
    <p class="mt-3 text-mist max-w-2xl">Points have no fixed value, so every assumption below is yours to change. Pool size loads live from DefiLlama.</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      <section class="panel space-y-4" aria-labelledby="in">
        <h2 id="in" class="font-display text-xl font-bold">Your assumptions</h2>
        <div class="grid grid-cols-2 gap-4">
          <div><label class="label" for="amt">Amount (ETH)</label><input id="amt" class="field" type="number" step="any" min="0" value="0.5" /></div>
          <div><label class="label" for="dur">Duration</label>
            <select id="dur" class="field"><option value="30">30 days</option><option value="60">60 days</option><option value="90">90 days</option></select></div>
          <div class="col-span-2"><label class="label" for="proto">Protocol</label>
            <select id="proto" class="field">
              <option value="eigenlayer">EigenLayer</option>
              <option value="symbiotic">Symbiotic</option>
              <option value="karak">Karak</option>
            </select></div>
          <div><label class="label" for="rate">Points per ETH per day</label><input id="rate" class="field" type="number" step="any" min="0" value="24" /></div>
          <div><label class="label" for="apy">Base staking APY (%)</label><input id="apy" class="field" type="number" step="any" min="0" value="3" /></div>
          <div><label class="label" for="tvl">Total pool size (ETH)</label><input id="tvl" class="field" type="number" step="any" min="0" value="3000000" /></div>
          <div><label class="label" for="ethp">ETH price (USD)</label><input id="ethp" class="field" type="number" step="any" min="0" value="3000" /></div>
          <div><label class="label" for="fdv">Expected token FDV (USD)</label><input id="fdv" class="field" type="number" step="any" min="0" value="2000000000" /></div>
          <div><label class="label" for="air">Airdrop share of supply (%)</label><input id="air" class="field" type="number" step="any" min="0" value="5" /></div>
          <div class="col-span-2"><label class="label" for="fee">Gas and entry costs (USD)</label><input id="fee" class="field" type="number" step="any" min="0" value="15" /></div>
        </div>
        <p id="src" class="note">Loading live pool size...</p>
      </section>

      <section class="panel" aria-labelledby="out" aria-live="polite">
        <h2 id="out" class="font-display text-xl font-bold mb-4">Projection</h2>
        <div class="grid grid-cols-2 gap-3">
          <div class="stat"><span>Points earned</span><b id="pts">-</b></div>
          <div class="stat"><span>Share of pool</span><b id="share">-</b></div>
          <div class="stat"><span>Airdrop value</span><b id="air-v">-</b></div>
          <div class="stat"><span>Base yield</span><b id="yld">-</b></div>
          <div class="stat col-span-2"><span>Expected net profit</span><b id="net">-</b></div>
        </div>
        <p class="note mt-4">Airdrop value = your pool share x FDV x airdrop %. It assumes points are split in proportion to ETH restaked over the same period. Points per ETH per day starts at 24 for EigenLayer (1 per hour); the Symbiotic and Karak presets are rough placeholders, so check each protocol's own docs.</p>
        <a class="btn mt-5" href={AFFILIATES.eth.url} rel="sponsored noopener" target="_blank">{AFFILIATES.eth.label}</a>
      </section>
    </div>
  </div>

  <script>
    import { $, num, usd, pct, getPrices } from '../lib/api';
    const PRESETS: Record<string, number> = { eigenlayer: 24, symbiotic: 10, karak: 20 };

    function calc() {
      const amt = num('amt'), days = parseInt(($('dur') as HTMLSelectElement).value, 10);
      const tvl = Math.max(num('tvl'), amt), price = num('ethp');
      const pts = amt * num('rate') * days;
      const share = tvl > 0 ? amt / tvl : 0;
      const air = share * num('fdv') * (num('air') / 100);
      const yld = amt * price * (num('apy') / 100) * (days / 365);
      const net = air + yld - num('fee');
      $('pts').textContent = Math.round(pts).toLocaleString('en-US');
      $('share').textContent = pct(share * 100).replace(/^0\.00%$/, '<0.01%');
      $('air-v').textContent = usd(air);
      $('yld').textContent = usd(yld);
      $('net').textContent = (net >= 0 ? '+' : '') + usd(net);
      $('net').className = net >= 0 ? 'good' : 'bad';
    }

    async function load() {
      const slug = ($('proto') as HTMLSelectElement).value;
      $('src').textContent = 'Loading live pool size...';
      try {
        const p = (await getPrices(['ethereum']))['ethereum'];
        if (p) ($('ethp') as HTMLInputElement).value = String(Math.round(p));
        const r = await fetch(`https://api.llama.fi/tvl/${slug}`);
        const tvlUsd = parseFloat(await r.text());
        if (!isFinite(tvlUsd)) throw new Error();
        ($('tvl') as HTMLInputElement).value = String(Math.round(tvlUsd / (p || num('ethp'))));
        $('src').textContent = 'Pool size and ETH price are live (DefiLlama, CoinGecko).';
      } catch { $('src').textContent = 'Live data unavailable. Enter pool size and ETH price manually.'; }
      calc();
    }

    $('proto').addEventListener('change', () => {
      ($('rate') as HTMLInputElement).value = String(PRESETS[($('proto') as HTMLSelectElement).value]);
      load();
    });
    document.querySelectorAll('input, #dur').forEach((i) => i.addEventListener('input', calc));
    calc(); load();
  </script>
</Base>
